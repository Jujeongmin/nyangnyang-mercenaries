{
  "meta": {
    "version": "1.0",
    "description": "무한 퀘스트 체인. 순차 단일 진행 - 동시 진행 없음. 항상 다음 목표 하나만 보인다.",
    "designPrinciple": "Q(N) 보상 = Q(N+1) 달성에 필요한 재화. 퀘스트 체인이 스스로 연료를 공급한다.",
    "sideEffect": "Q1~Q6만 따라가면 6개 시스템을 전부 경험한다. 별도 튜토리얼이 불필요해진다."
  },
  "cycle": {
    "length": 6,
    "slotFormula": "slot = ((N - 1) mod 6) + 1",
    "cycleFormula": "k = ceil(N / 6)",
    "slots": [
      {
        "slot": 1,
        "type": "stage_clear",
        "targetFormula": "5 * k",
        "needs": "CP",
        "prevRewardShouldGive": [
          "gold",
          "golden_key"
        ]
      },
      {
        "slot": 2,
        "type": "mercenary_summon",
        "targetFormula": "10 * k^1.6",
        "needs": "다이아 / 용병 소환권",
        "prevRewardShouldGive": [
          "merc_ticket",
          "diamond"
        ]
      },
      {
        "slot": 3,
        "type": "skill_summon",
        "targetFormula": "8 * k^1.6",
        "needs": "다이아 / 스킬 소환권",
        "prevRewardShouldGive": [
          "skill_ticket",
          "diamond"
        ]
      },
      {
        "slot": 4,
        "type": "equip_summon_level",
        "targetFormula": "min(2 * k, 60)",
        "needs": "제련석 + 시간",
        "prevRewardShouldGive": [
          "forge_ore",
          "speedup_item"
        ]
      },
      {
        "slot": 5,
        "type": "dungeon_floor",
        "targetFormula": "3 * k",
        "needs": "CP + 입장 횟수",
        "prevRewardShouldGive": [
          "gold",
          "golden_key",
          "dungeon_entry"
        ]
      },
      {
        "slot": 6,
        "type": "power_reach",
        "targetFormula": "권장CP * 1.1",
        "needs": "모든 성장 재화",
        "prevRewardShouldGive": [
          "diamond",
          "ticket_mixed"
        ]
      }
    ]
  },
