 "generationRule": {
  "note": "Q25 이후는 자동 생성. 보상이 다음 퀘스트에서 자동 역산되므로 수동 작성 불필요.",
  "pseudocode": [
   "k = ceil(N / 6)",
   "slot = ((N - 1) mod 6) + 1",
   "supply = k <= 1 ? 1.0 : k <= 2 ? 0.9 : k <= 3 ? 0.8 : k <= 4 ? 0.7 : 0.6",
   "target(N) = cycle.slots[slot].targetFormula(k)",
   "reward(N) = requiredResources(quest N+1) * supply(k)"
  ]
 },
