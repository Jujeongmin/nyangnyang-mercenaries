    "principle": "방치형은 무음으로 플레이하는 유저가 많다. 사운드 없이도 게임이 완전히 성립해야 하고, 사운드는 순수 가산 요소여야 한다."
  },
  "format": {
    "bgm": {
      "codec": "mp3",
      "bitrate": "96kbps",
      "channels": "stereo",
      "loop": true,
      "targetSizeEach": "약 1MB"
    },
    "sfx": {
      "codec": "mp3",
      "bitrate": "96kbps",
      "channels": "mono",
      "targetSizeEach": "10~30KB"
