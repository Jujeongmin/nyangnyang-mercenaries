    "webAudioUnlock": {
      "required": true,
      "note": "브라우저 자동재생 정책상 최초 사용자 터치 전에는 오디오가 재생되지 않는다. 첫 탭에서 AudioContext 를 언락하고, 그전까지는 무음으로 진행한다."
    },
    "volumeLayers": [
      "bgm",
      "sfx"
    ],
    "volumeStorage": "save-schema.json > settings.sound",
    "muteOnBackground": true,
