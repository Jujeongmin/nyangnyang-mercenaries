#!/bin/sh
#
# 배포링크가 밀 때마다 바뀌던 것을 막는다.
#
# 배포 주소는 `VITE_AGENT8_VERSE` 로 갈린다. 그 값은 `.env` 와 `.agent8.lock`
# 두 곳에 있고 둘 다 저장소에 들어간다. Verse8 에디터 컨테이너가 이따금 새
# 값을 찍어 커밋하는데(2026-08-25~26 사이만 네 번), 옛 값이 든 판을 밀면
# 배포가 딴 주소로 나간다.
#
# 그래서 밀기 직전에, **미는 커밋 안의 값**이 못박은 값(tools/verse.pin)과
# 같은지 본다. 작업본이 아니라 커밋을 보는 이유는 실제로 나가는 것이 커밋이라서다.
#
# **2026-08-30: 막지 않고 알리기만 한다.** 배포 대상은 이 파일이 아니라 배포
# 창의 선택([Update existing game])이 정한다는 것이 드러났고, 에디터 컨테이너가
# 배포할 때마다 락을 제 값으로 되돌리기 때문에 막으면 일이 안 된다.
# 그래도 값이 흔들린 것은 알아야 하므로 경고는 남긴다.
#
# 기준값을 바꾸려면 tools/verse.pin 을 고친다 — 지금은 **서비스 중인 게임의
# verse** 를 담는다 (컨테이너가 저장소에 써 넣는 값과 다를 수 있다).

PIN_FILE="tools/verse.pin"
[ -f "$PIN_FILE" ] || exit 0
PIN=$(tr -d ' \t\r\n' < "$PIN_FILE")
[ -n "$PIN" ] || exit 0

fail=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # 브랜치 삭제 push — 볼 것이 없다
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  for f in .env .agent8.lock; do
    val=$(git show "$local_sha:$f" 2>/dev/null | sed -n 's/^VITE_AGENT8_VERSE=//p' | tr -d ' \t\r')
    [ -n "$val" ] || continue
    if [ "$val" != "$PIN" ]; then
      echo "⚠ verse 가 흔들렸다 — $f 의 값이 못박은 값과 다르다." >&2
      echo "  커밋 $(git rev-parse --short "$local_sha") : $val" >&2
      echo "  $PIN_FILE          : $PIN" >&2
      fail=1
    fi
  done
done

if [ "$fail" = 1 ]; then
  echo "" >&2
  echo "※ 막지는 않는다 — 배포 대상은 이 파일이 아니라 배포 창의 선택이 정한다." >&2
  echo "  Verse8 에디터 컨테이너가 배포할 때마다 .env/.agent8.lock 을 제 값으로" >&2
  echo "  되돌린다. 그때마다 푸시를 막으면 일이 안 되므로 알리기만 한다." >&2
  echo "" >&2
  echo "  ▶ 배포 창에서는 반드시 [Update existing game] 을 고른다." >&2
  echo "    [Publish as new game] 은 락에 든 verse 로 새 게임을 만들려 하고," >&2
  echo "    그 값이 이미 쓰이고 있으면 \"already in use\" 로 막힌다." >&2
  echo "" >&2
  echo "  지금 서비스 중인 게임의 verse: $PIN" >&2
  echo "  (https://verse8.io/R7N5n3y — 유저 세이브가 여기 쌓여 있다)" >&2
fi

exit 0
